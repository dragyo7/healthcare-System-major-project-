# =====================================================================
# Healthcare CDS Platform — Root Environment Template
# =====================================================================
# Copy to respective module .env files and populate with environment secrets.
# NEVER commit production secrets or actual credentials into source control.

# --- Express EHR Gateway & Backend ---
EXPRESS_PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=healthcare_app_user
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_NAME=rag_healthcare
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_SECRET_MIN_32_CHARS
ENABLE_DEV_LOCAL_ACTIVATION_LINKS=false
NODE_ENV=development

# --- FastAPI CDS & Medical RAG Engine ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
# Medical RAG Index Path (Frozen Production Chunks)
FAISS_INDEX_PATH=data/faiss_index/index_v2.bin
FAISS_META_PATH=data/faiss_index/meta_v2.pkl

# --- Frontends (Vite) ---
VITE_API_URL=http://localhost:5000
DOCTOR_PORTAL_PORT=5173
RECEPTIONIST_PORTAL_PORT=5174
PATIENT_PORTAL_PORT=5175
