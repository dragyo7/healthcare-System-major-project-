# ==============================================================================
# CareUnity CDSS — Frontend Environment Configuration Template
# ==============================================================================

# Express EHR Gateway Backend
# Default port: 5000 (when started via npm start / scripts/start_platform.ps1)
# Test runner port: 5001 (when started against isolated test database)
# Client includes automatic fallback between 5000 and 5001
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_API_URL=http://127.0.0.1:5000

# FastAPI CDS Gateway & Frozen RAG Engine
VITE_FASTAPI_URL=http://127.0.0.1:8000

# Supabase Auth / Storage (Optional Fallback)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application Branding
VITE_APP_NAME=CareUnity CDSS Healthcare
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LANGUAGE=en
