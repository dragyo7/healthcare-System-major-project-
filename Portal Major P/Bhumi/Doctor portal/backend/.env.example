# =====================================================================
# Express EHR Backend & CDS Gateway Environment Configuration
# =====================================================================
# COPY THIS FILE TO .env AND FILL IN ENVIRONMENT-SPECIFIC CREDENTIALS.
# NEVER COMMIT .env TO SOURCE CONTROL.

# Application Port
PORT=5000

# MySQL Database Connection (rag_healthcare)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=healthcare_app_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD
DB_NAME=rag_healthcare

# JWT Authentication Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=YOUR_CRYPTOGRAPHIC_JWT_SECRET_MIN_32_CHARS

# Internal FastAPI CDS Gateway URL (Must remain private/loopback, never exposed publicly)
FASTAPI_CDS_URL=http://127.0.0.1:8000

# Development-Only Patient Activation Link Exposure
# STRICT FAIL-CLOSED: Must be explicitly 'true' to return activation links in response JSON.
# Ignored and completely blocked if NODE_ENV=production.
ENABLE_DEV_LOCAL_ACTIVATION_LINKS=false

# Environment Mode: 'development' | 'test' | 'production'
NODE_ENV=development
