  {
    "document_id": "mplus_hypertension_classification_and_thresholds",
    "source_id": "MedlinePlus",
    "source_name": "MedlinePlus Health Topics (NLM / NIH)",
    "publisher": "National Library of Medicine (NLM/NIH)",
    "title": "High Blood Pressure (Hypertension) - Classification and Thresholds",
    "content": "Topic: High Blood Pressure (Hypertension)\nSection: Classification and Thresholds\nPublisher: National Library of Medicine (NLM/NIH)\n\nStandard clinical blood pressure categories: Normal: Systolic < 120 mmHg and Diastolic < 80 mmHg; Elevated: Systolic 120-129 mmHg and Diastolic < 80 mmHg; Stage 1 Hypertension: Systolic 130-139 mmHg or Diastolic 80-89 mmHg; Stage 2 Hypertension: Systolic >= 140 mmHg or Diastolic >= 90 mmHg; Hypertensive Crisis: Systolic > 180 mmHg and/or Diastolic > 120 mmHg (requires immediate emergency medical attention).",
    "source_url": "https://medlineplus.gov/highbloodpressure.html",
    "document_type": "disease_summary",
    "evidence_role": "reference_summary",
    "provenance_status": "VERIFIED",
